<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_container"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/bar_usb"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/bar_usb_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_off"
            android:contentDescription="@null"
            android:padding="10dp"
            android:src="@drawable/ic_usb" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/widget_usb"
            android:textColor="@color/widget_text"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bar_wireless"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/bar_wireless_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_off"
            android:contentDescription="@null"
            android:padding="10dp"
            android:src="@drawable/ic_wifi" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/widget_wireless"
            android:textColor="@color/widget_text"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
