<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="4dp">

    <TextView
        android:id="@+id/w_usb"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="@drawable/widget_btn_off"
        android:gravity="center"
        android:text="@string/widget_usb"
        android:textColor="@color/widget_text_off"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_wireless"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="@drawable/widget_btn_off"
        android:gravity="center"
        android:text="@string/widget_wireless"
        android:textColor="@color/widget_text_off"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_dev"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="@drawable/widget_btn_off"
        android:gravity="center"
        android:text="@string/widget_dev"
        android:textColor="@color/widget_text_off"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
