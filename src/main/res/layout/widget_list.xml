<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_container"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/list_usb"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/list_usb_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/circle_off"
            android:contentDescription="@null"
            android:padding="9dp"
            android:src="@drawable/ic_usb" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/label_usb"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/list_usb_switch"
            android:layout_width="44dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:src="@drawable/switch_off_img" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/list_wireless"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/list_wireless_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/circle_off"
            android:contentDescription="@null"
            android:padding="9dp"
            android:src="@drawable/ic_wifi" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/label_wireless"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/list_wireless_switch"
            android:layout_width="44dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:src="@drawable/switch_off_img" />
    </LinearLayout>
</LinearLayout>
